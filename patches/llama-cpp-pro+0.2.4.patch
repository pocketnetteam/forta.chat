+// Ported from the `llama-cpp-capacitor@0.1.5` patch (patches/) during the
+// `llama-cpp-pro` migration — this file still has the same bug in 0.2.4,
+// it was never upstreamed.
+std::string sanitize_utf8(const std::string& s) {
+    size_t len = s.size();
+    size_t i = 0;
+    while (i < len) {
+        unsigned char c = static_cast<unsigned char>(s[i]);
+        int seq_len;
+        if ((c & 0x80) == 0x00) seq_len = 1;      // 0xxxxxxx
+        else if ((c & 0xE0) == 0xC0) seq_len = 2; // 110xxxxx
+        else if ((c & 0xF0) == 0xE0) seq_len = 3; // 1110xxxx
+        else if ((c & 0xF8) == 0xF0) seq_len = 4; // 11110xxx
+        else return s.substr(0, i);               // not a valid lead byte (stray continuation byte, or 0xF8-0xFF) — truncate here
+        if (i + static_cast<size_t>(seq_len) > len) return s.substr(0, i); // sequence runs past the end of the string — incomplete, truncate here
