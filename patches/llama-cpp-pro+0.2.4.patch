+            unsigned char cont = static_cast<unsigned char>(s[i + k]);
+            if ((cont & 0xC0) != 0x80) return s.substr(0, i); // expected a continuation byte (10xxxxxx) and didn't find one — truncate here
+        }
+        i += seq_len;
+    }
+    return s;
